# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# The publishable/anon key is safe to expose to the browser (it is the public
# API key; all protection comes from RLS). SUPABASE_SERVICE_ROLE_KEY is a
# SERVER-ONLY secret: it must never appear in a VITE_* variable, because Vite
# inlines any `VITE_*` name into the public client bundle.

# Client & SSR Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"

# WebRTC TURN Configuration (Required in Production for Symmetric NAT/Cellular traversal)
# SAFE DEFAULT (H-6): the browser MUST NOT carry long-lived TURN credentials.
# Run a TURN server (coturn) with a static auth secret, then set the edge
# function secrets below — the turn-credentials function mints TTL-bound
# username/credential pairs per signed-in member. VITE_TURN_* is only a
# self-hosted fallback when the function is absent.

# -----------------------------------------------------------------------------
# SUPABASE EDGE FUNCTION SECRETS (Set via `supabase secrets set KEY=VALUE`)
# Do NOT place these inside the browser client bundle!
# -----------------------------------------------------------------------------
# SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
#
# Razorpay Subscriptions (Production)
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"
#
# Outbound Notifications (Email, SMS, WhatsApp)
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# ALERT_FROM_EMAIL="The Merit Circle <alerts@themeritcircle.in>"
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"
# WHATSAPP_SENDER_NUMBER="+1xxxxxxxxxx"
#
# Unattended cron callers (H-3 & F-14: shared secret, rotation via _PREVIOUS)
# CRON_SECRET="..."
# CRON_SECRET_PREVIOUS="..."  # only during rotation
#
# Ephemeral TURN credentials (H-6: coturn static-auth-secret + realm;
# comma-separated relay URLs served to signed-in members with a 6h TTL)
# TURN_STATIC_SECRET="..."
# TURN_REALM="themeritcircle.in"
# TURN_URLS="turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349"

# Shared guest-preview account (local development only — never set in production).
# F-03: In addition to DEMO_GUEST_PASSWORD, ENABLE_DEMO_MODE=true must be explicitly
# set to unlock guest preview. This prevents staging or misconfigured production
# environments from accidentally enabling the demo bypass.
# ENABLE_DEMO_MODE=true
# DEMO_GUEST_PASSWORD=choose-a-local-only-guest-password
